# Copy this file to .env.local (same folder) and fill in the values.
# .env.local is ignored by Git. Never commit real keys.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase: Project Settings > Database > Connection string (URI).
# Used once to create the tables.
SUPABASE_DB_URL=

# AI Coach (server-side only)
ANTHROPIC_API_KEY=

# Optional: force the local stand-in (browser storage, simulated sign-in) even when Supabase keys exist.
# NEXT_PUBLIC_FORCE_LOCAL_MODE=1
