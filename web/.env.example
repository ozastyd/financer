# Copy this file to .env.local (same folder) and fill in the values.
# .env.local is ignored by Git. Never commit real keys.

# Required: signs login cookies. Generate with: openssl rand -hex 32
# Users create their own accounts (email + password) in the app.
SESSION_SECRET=

# SQLite database file (default ./data/financer.db). Keep it outside the repo in production.
DATABASE_PATH=

# AI Coach: any OpenAI-compatible chat-completions API (server-side only)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional: low (default) or none
AI_REASONING_EFFORT=

# Optional: web search for the AI Coach (https://exa.ai)
EXA_API_KEY=

# Optional: receipt / bank statement scanning (https://console.groq.com)
GROQ_API_KEY=
# Optional: vision model, default qwen/qwen3.8-27b
SCAN_MODEL=
